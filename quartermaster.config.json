{
  "work_dir": "./data",
  "log_file": "weekly.log",
  "copy_to": null,
  "embed": {
    "provider": "ollama",
    "url": "http://127.0.0.1:11434",
    "model": "qwen3-embedding:0.6b"
  },
  "query": {
    "min_sim": 0.60
  },
  "scan": {
    "skill_roots": [
      "~/.claude/skills",
      "~/.claude/plugins/cache",
      "~/.claude/plugins/marketplaces"
    ],
    "agents_dir": "~/.claude/agents",
    "claude_settings": "~/.claude/settings.json",
    "mcp_dir": null,
    "ollama_models": true
  }
}
